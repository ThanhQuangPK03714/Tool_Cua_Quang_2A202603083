# CVAT Server Configuration
CVAT_SERVER_URL=http://localhost:8080
CVAT_ORGANIZATION=
CVAT_AUTH_MODE=session
CVAT_USERNAME=your-cvat-username
CVAT_PASSWORD=your-cvat-password
CVAT_ACCESS_TOKEN=

# Model Configuration
MODEL_DEVICE=auto
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
YOLO_WEIGHTS=yolov8n-seg.pt
SAM3_WEIGHTS=

# Output Configuration
OUTPUT_DIR=outputs
PREVIEWS_DIR=outputs/previews
LOGS_DIR=outputs/logs
